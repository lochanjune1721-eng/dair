# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server routes only. Never imported by a client component.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_ACCOUNT_ID=acct_1SNgH8ItrE8tEH6a

# Voting integrity — any long random string. Changing it invalidates existing
# IP hashes (fingerprint cookies still work).
FINGERPRINT_SALT=

# Admin
ADMIN_PASSWORD=

# Optional
# Signs /upload/[token] links. Falls back to FINGERPRINT_SALT if unset.
UPLOAD_TOKEN_SECRET=
# Absolute site URL used in Stripe redirects, upload links and OG metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Bearer token required by /api/cron/release-slots. Unset means no auth.
CRON_SECRET=
# Sends the post-payment upload link. Unset logs it to the server console
# instead; the admin table always exposes a copyable link per entry.
RESEND_API_KEY=
MAIL_FROM="Dair <onboarding@resend.dev>"
